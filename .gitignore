# Internal planning docs - not part of the published site
/docs/

# Never allow credentials/secrets into this repo
*.env
*creds*
*password*
*secret*

# Local worktrees for isolated task execution
/.worktrees/

# Jekyll build artifacts
/_site/
/.jekyll-cache/
/.bundle/

# Raw REST API dumps - regeneratable, not needed once posts/assets exist
/scripts/migration/data/

# Python virtualenvs and caches
**/.venv/
**/__pycache__/
.pytest_cache/
